rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Security Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints ---
    function isValidStudioProject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.resolution is string && data.resolution in ['4K 60fps', '1080p 60fps', '8K RAW', '9:16 Reels'] &&
             data.aspectRatio is string && data.aspectRatio in ['16:9', '9:16', '1:1', '2.39:1'] &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.status is string && data.status in ['editing', 'rendering', 'ready', 'archived'] &&
             data.lutPreset is string && data.lutPreset.size() >= 1 && data.lutPreset.size() <= 80 &&
             data.shootLocationName is string && data.shootLocationName.size() <= 140 &&
             data.shootLat is number && data.shootLat >= -90.0 && data.shootLat <= 90.0 &&
             data.shootLng is number && data.shootLng >= -180.0 && data.shootLng <= 180.0 &&
             data.collaboratorCount is int && data.collaboratorCount >= 1 && data.collaboratorCount <= 500 &&
             data.proxyEnabled is bool;
    }

    function isValidTimelineClip(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.trackType is string && data.trackType in ['video', 'audio', 'vfx', 'caption'] &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 200 &&
             data.startMs is int && data.startMs >= 0 && data.startMs <= 86400000 &&
             data.durationMs is int && data.durationMs >= 100 && data.durationMs <= 86400000 &&
             data.speedMultiplier is number && data.speedMultiplier >= 0.25 && data.speedMultiplier <= 8.0 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 16 &&
             data.mediaUri is string && data.mediaUri.size() <= 1024 &&
             data.notes is string && data.notes.size() <= 1000;
    }

    function isValidReviewComment(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.timestampMs is int && data.timestampMs >= 0 && data.timestampMs <= 86400000 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 600 &&
             data.resolved is bool;
    }

    function isValidRenderJob(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.projectId is string && isValidId(data.projectId) &&
             data.projectTitle is string && data.projectTitle.size() >= 1 && data.projectTitle.size() <= 120 &&
             data.profile is string && data.profile.size() >= 1 && data.profile.size() <= 80 &&
             data.status is string && data.status in ['queued', 'rendering', 'completed', 'cancelled'] &&
             data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100;
    }

    function isValidShootLocation(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
             data.category is string && data.category in ['Exterior', 'Studio', 'Aerial', 'Render Hub'] &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.scoutingNotes is string && data.scoutingNotes.size() <= 1000 &&
             data.projectId is string && data.projectId.size() <= 128;
    }

    function isValidAuditLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 60 &&
             data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 100 &&
             data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 400;
    }

    function isValidAiChatThread(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.modelName is string && data.modelName in ['gemini-3.8-flash', 'gemini-3.5-flash-lite'] &&
             data.systemInstruction is string && data.systemInstruction.size() <= 1000 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000;
    }

    function isValidAiChatMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.role is string && data.role in ['user', 'model'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 50000 &&
             data.hasImage is bool &&
             data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 60;
    }

    // --- User-Scoped Studio Collections ---
    match /users/{userId}/projects/{projectId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(projectId);

      allow create: if isOwner(userId) &&
                       isValidId(projectId) &&
                       incoming().keys().hasAll(['userId', 'title', 'resolution', 'aspectRatio', 'durationSeconds', 'status', 'lutPreset', 'shootLocationName', 'shootLat', 'shootLng', 'collaboratorCount', 'proxyEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'resolution', 'aspectRatio', 'durationSeconds', 'status', 'lutPreset', 'shootLocationName', 'shootLat', 'shootLng', 'collaboratorCount', 'proxyEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidStudioProject(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(projectId) &&
                       isValidStudioProject(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'resolution', 'aspectRatio', 'durationSeconds', 'status', 'lutPreset', 'shootLocationName', 'shootLat', 'shootLng', 'collaboratorCount', 'proxyEnabled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(projectId);

      // Subcollection: Timeline Clips (Parent Gate on StudioProject)
      match /clips/{clipId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(projectId) && isValidId(clipId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) && isValidId(clipId) &&
                         incoming().keys().hasAll(['userId', 'trackType', 'label', 'startMs', 'durationMs', 'speedMultiplier', 'colorHex', 'mediaUri', 'notes', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'trackType', 'label', 'startMs', 'durationMs', 'speedMultiplier', 'colorHex', 'mediaUri', 'notes', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidTimelineClip(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));

        allow update: if isOwner(userId) &&
                         isValidId(projectId) && isValidId(clipId) &&
                         isValidTimelineClip(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['trackType', 'label', 'startMs', 'durationMs', 'speedMultiplier', 'colorHex', 'mediaUri', 'notes', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(projectId) && isValidId(clipId);
      }

      // Subcollection: Review Comments (Parent Gate on StudioProject)
      match /comments/{commentId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(projectId) && isValidId(commentId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) && isValidId(commentId) &&
                         incoming().keys().hasAll(['userId', 'authorName', 'timestampMs', 'body', 'resolved', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'authorName', 'timestampMs', 'body', 'resolved', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidReviewComment(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));

        allow update: if isOwner(userId) &&
                         isValidId(projectId) && isValidId(commentId) &&
                         isValidReviewComment(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['body', 'resolved', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(projectId) && isValidId(commentId);
      }
    }

    // Cloud & GPU Render Queue Jobs (Terminal State Locked)
    match /users/{userId}/renderJobs/{jobId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(jobId);

      allow create: if isOwner(userId) &&
                       isValidId(jobId) &&
                       incoming().keys().hasAll(['userId', 'projectId', 'projectTitle', 'profile', 'status', 'progressPercent', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'projectId', 'projectTitle', 'profile', 'status', 'progressPercent', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidRenderJob(incoming(), userId) &&
                       exists(/databases/$(database)/documents/users/$(userId)/projects/$(incoming().projectId));

      allow update: if isOwner(userId) &&
                       isValidId(jobId) &&
                       !(existing().status in ['completed', 'cancelled']) &&
                       isValidRenderJob(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().projectId == existing().projectId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'progressPercent', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(jobId);
    }

    // Geotagged Shoot Locations
    match /users/{userId}/locations/{locationId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(locationId);

      allow create: if isOwner(userId) &&
                       isValidId(locationId) &&
                       incoming().keys().hasAll(['userId', 'name', 'category', 'latitude', 'longitude', 'scoutingNotes', 'projectId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'category', 'latitude', 'longitude', 'scoutingNotes', 'projectId', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidShootLocation(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(locationId) &&
                       isValidShootLocation(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'latitude', 'longitude', 'scoutingNotes', 'projectId', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(locationId);
    }

    // Append-Only Security Audit Logs
    match /users/{userId}/auditLogs/{logId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(logId);

      allow create: if isOwner(userId) &&
                       isValidId(logId) &&
                       incoming().keys().hasAll(['userId', 'eventType', 'deviceLabel', 'detail', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'eventType', 'deviceLabel', 'detail', 'createdAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidAuditLog(incoming(), userId);

      allow update, delete: if false;
    }

    // Personal AI Assistant Chat Threads & Messages
    match /users/{userId}/aiThreads/{threadId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(threadId);

      allow create: if isOwner(userId) &&
                       isValidId(threadId) &&
                       incoming().keys().hasAll(['userId', 'title', 'modelName', 'systemInstruction', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'modelName', 'systemInstruction', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidAiChatThread(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(threadId) &&
                       isValidAiChatThread(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'modelName', 'systemInstruction', 'lastMessagePreview', 'messageCount', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(threadId);

      // Subcollection: Chat Messages (Parent Gate on AiChatThread)
      match /messages/{messageId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(threadId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(threadId) && isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'role', 'text', 'hasImage', 'modelName', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'role', 'text', 'hasImage', 'modelName', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidAiChatMessage(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/aiThreads/$(threadId));

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(threadId) && isValidId(messageId);
      }
    }
  }
}
